---
interface Repo {
	id: number;
	name: string;
	description: string | null;
	html_url: string;
	stargazers_count: number;
	forks_count: number;
	language: string | null;
	updated_at: string;
}

let repos: Repo[] = [];
let error = false;

try {
	const response = await fetch(
		'https://api.github.com/users/mcendon/repos?sort=updated&per_page=6'
	);
	if (response.ok) {
		repos = await response.json();
	} else {
		error = true;
	}
} catch (e) {
	error = true;
	console.error('Failed to fetch GitHub repos:', e);
}
---

<div class="github-repos-container">
	{
		error ? (
			<div class="error-message">
				<p>Unable to load repositories at this time.</p>
			</div>
		) : (
			<div class="repos-grid">
				{repos.map((repo) => (
					<a href={repo.html_url} target="_blank" rel="noopener noreferrer" class="repo-card group">
						<div class="repo-header">
							<h3 class="repo-name">{repo.name}</h3>
							<svg
								class="external-link"
								width="16"
								height="16"
								viewBox="0 0 16 16"
								fill="currentColor"
							>
								<path d="M3.75 2h3.5a.75.75 0 0 1 0 1.5h-3.5a.25.25 0 0 0-.25.25v8.5c0 .138.112.25.25.25h8.5a.25.25 0 0 0 .25-.25v-3.5a.75.75 0 0 1 1.5 0v3.5A1.75 1.75 0 0 1 12.25 14h-8.5A1.75 1.75 0 0 1 2 12.25v-8.5C2 2.784 2.784 2 3.75 2Zm6.854-1h4.146a.25.25 0 0 1 .25.25v4.146a.25.25 0 0 1-.427.177L13.03 4.03 9.28 7.78a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042l3.75-3.75-1.543-1.543A.25.25 0 0 1 10.604 1Z" />
							</svg>
						</div>
						<p class="repo-description">{repo.description || 'No description available'}</p>
						<div class="repo-footer">
							{repo.language && (
								<span class="repo-language">
									<span class="language-dot" />
									{repo.language}
								</span>
							)}
							<span class="repo-stars">
								<svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
									<path d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.751.751 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z" />
								</svg>
								{repo.stargazers_count}
							</span>
						</div>
					</a>
				))}
			</div>
		)
	}
</div>

<style>
	.github-repos-container {
		width: 100%;
		height: 100%;
	}

	.error-message {
		display: flex;
		align-items: center;
		justify-content: center;
		height: 100%;
		color: var(--muted-foreground);
	}

	.repos-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
		gap: 1rem;
		height: 100%;
	}

	.repo-card {
		display: flex;
		flex-direction: column;
		padding: 1.25rem;
		background: var(--card);
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		text-decoration: none;
		color: var(--foreground);
		transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
		position: relative;
		overflow: hidden;
	}

	.repo-card::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		background: linear-gradient(135deg, var(--primary-accent) 0%, var(--secondary-accent) 100%);
		opacity: 0;
		transition: opacity 0.3s ease;
		z-index: 0;
	}

	.repo-card:hover::before {
		opacity: 0.05;
	}

	.repo-card:hover {
		transform: translateY(-4px);
		box-shadow: 0 12px 24px rgba(0, 0, 0, 0.15);
		border-color: var(--primary-accent);
	}

	.repo-card > * {
		position: relative;
		z-index: 1;
	}

	.repo-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 0.75rem;
	}

	.repo-name {
		font-size: 1rem;
		font-weight: 600;
		margin: 0;
		color: var(--foreground);
	}

	.external-link {
		opacity: 0.5;
		transition: opacity 0.2s ease;
		flex-shrink: 0;
	}

	.repo-card:hover .external-link {
		opacity: 1;
	}

	.repo-description {
		font-size: 0.875rem;
		color: var(--muted-foreground);
		margin: 0 0 auto 0;
		line-height: 1.5;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.repo-footer {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin-top: 1rem;
		font-size: 0.75rem;
		color: var(--muted-foreground);
	}

	.repo-language {
		display: flex;
		align-items: center;
		gap: 0.375rem;
	}

	.language-dot {
		width: 12px;
		height: 12px;
		border-radius: 50%;
		background: var(--primary);
	}

	.repo-stars {
		display: flex;
		align-items: center;
		gap: 0.25rem;
	}

	@media (max-width: 768px) {
		.repos-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
